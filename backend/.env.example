# ── Flask ──────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development

# ── Database ───────────────────────────────────────────────────
# Docker Compose (use this when running inside Docker)
DATABASE_URL=postgresql://venkern:venkern123@db:5432/venkern

# Local development (use this when running outside Docker)
# DATABASE_URL=postgresql://venkern:venkern123@localhost:5432/venkern

# ── Security ───────────────────────────────────────────────────
SECRET_KEY=troque-essa-chave-em-producao
JWT_SECRET_KEY=troque-essa-chave-jwt-em-producao

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Uploads ────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads

# ── Seed ───────────────────────────────────────────────────────
# Set to "true" to run seed.py automatically on container startup (development only)
SEED_DB=false
