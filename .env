# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=venkern_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-me-in-production

# ── CORS (must match where the frontend is served from) ───────
CORS_ORIGINS=http://localhost

# ── Frontend port on the host ─────────────────────────────────
FRONTEND_PORT=80

# ── Set to "true" to seed the DB on first backend startup ─────
SEED_DB=false
